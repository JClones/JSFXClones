local(x y right bottom width height)
(
  column >= 0 && column < cols && row >= 0 && row < lines ? (
    x = floor(origin_x + column*cell_w);
    y = floor(origin_y + row*cell_h);
    right = floor(origin_x + (column+1)*cell_w);
    bottom = floor(origin_y + (row+1)*cell_h);
    ba > 0 ? (
      gfx_set(br,bg,bb,ba);
      gfx_rect(x,y,right-x,bottom-y);
    );
