      gfx_measurechar(code,width,height);
      gfx_set(fr,fg,fb,fa);
      gfx_x=origin_x+column*cell_w+(cell_w-width)*0.5;
      gfx_y=origin_y+row*cell_h+(cell_h-height)*0.5;
      gfx_drawchar(code);
    );
  );
);
function put_text(column, row, text)
local(i count)
(
  i = 0; count = strlen(text);
  loop(count,
    this.put_char(column+i,row,str_getchar(text,i,'cu'));
    i += 1;
  );
);

// 4x4 colored subpixels per character, used by the saved-profile knobs.
// Coordinates refer to the complete terminal: [0,cols*4) x [0,lines*4).
function put_subpixel(x, y, r, g, b, opacity)
instance(cols lines cell_w cell_h origin_x origin_y)
local(left top right bottom)
(
  x >= 0 && x < cols*4 && y >= 0 && y < lines*4 ? (
    left = floor(origin_x + x*cell_w*0.25);
    top = floor(origin_y + y*cell_h*0.25);
    right = floor(origin_x + (x+1)*cell_w*0.25);
    bottom = floor(origin_y + (y+1)*cell_h*0.25);
    gfx_set(r/255,g/255,b/255,opacity);
    gfx_rect(left,top,right-left,bottom-top);
  );
);

// Fit measured glyph width and height to the cell across platform substitutions.
// Re-evaluate only after a cell-size or display-scale change.
