is_bypass = slider7;

left.OInflator_setGains(input_gain, output_gain);
right.OInflator_setGains(input_gain, output_gain);

left.OInflator_setMode(clip, bandsplit, effect / 100.0, curve);
right.OInflator_setMode(clip, bandsplit, effect / 100.0, curve);

// refresh meters in dB once per block
meters.input_left_dB = K_TO_DB(max(meters.input_left, meters.MIN_LEVEL_LIN));
meters.input_right_dB = K_TO_DB(max(meters.input_right, meters.MIN_LEVEL_LIN));
meters.output_left_dB = K_TO_DB(max(meters.output_left, meters.MIN_LEVEL_LIN));
meters.output_right_dB = K_TO_DB(max(meters.output_right, meters.MIN_LEVEL_LIN));

// processing meters

meters.processing_left = sqrt((meters.y_rms2_left + meters.MIN_LEVEL_LIN^2) / (meters.x_rms2_left + meters.MIN_LEVEL_LIN^2));
meters.processing_right = sqrt((meters.y_rms2_right + meters.MIN_LEVEL_LIN^2) / (meters.x_rms2_right + meters.MIN_LEVEL_LIN^2));

meters.processing_left_dB = K_TO_DB(meters.processing_left);
meters.processing_right_dB = K_TO_DB(meters.processing_right);

@sample

(!is_bypass) ? (

  spl0 = left.OInflator_processSample(spl0);
  spl1 = right.OInflator_processSample(spl1);

  // metering
  meters.input_left += (abs(left.metering_x) - meters.input_left) * (abs(left.metering_x) > meters.input_left ? meters.fa : meters.fr);
  meters.input_right += (abs(right.metering_x) - meters.input_right) * (abs(right.metering_x) > meters.input_right ? meters.fa : meters.fr);
  meters.output_left += (abs(left.metering_output) - meters.output_left) * (abs(left.metering_output) > meters.output_left ? meters.fa : meters.fr);
  meters.output_right += (abs(right.metering_output) - meters.output_right) * (abs(right.metering_output) > meters.output_right ? meters.fa : meters.fr);

  // processing meters
  meters.x_rms2_left += (left.metering_x * left.metering_x - meters.x_rms2_left) * meters.fp;
  meters.x_rms2_right += (right.metering_x * right.metering_x - meters.x_rms2_right) * meters.fp;
  meters.y_rms2_left += (left.metering_y * left.metering_y - meters.y_rms2_left) * meters.fp;
  meters.y_rms2_right += (right.metering_y * right.metering_y - meters.y_rms2_right) * meters.fp;

) : (

  // metering
  meters.input_left += (abs(spl0) - meters.input_left) * (abs(spl0) > meters.input_left ? meters.fa : meters.fr);
  meters.input_right += (abs(spl1) - meters.input_right) * (abs(spl1) > meters.input_right ? meters.fa : meters.fr);
  meters.output_left += (abs(spl0) - meters.output_left) * (abs(spl0) > meters.output_left ? meters.fa : meters.fr);
  meters.output_right += (abs(spl1) - meters.output_right) * (abs(spl1) > meters.output_right ? meters.fa : meters.fr);

  // processing meters
  meters.x_rms2_left = 0.0;
  meters.x_rms2_right = 0.0;
  meters.y_rms2_left = 0.0;
  meters.y_rms2_right = 0.0;
);

// clip indicator
(abs(spl0) > 1.0) ? ( meters.output_clip_left = 1 );
(abs(spl1) > 1.0) ? ( meters.output_clip_right = 1 );


