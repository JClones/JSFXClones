local(candidate w h score best_score)
(
  width!=last_width || height!=last_height || gfx_ext_retina!=last_retina || font_size==0 ? (
    best_score=1000000;candidate=8;font_size=8;
    loop(93,
      gfx_setfont(1,"Courier New",candidate,'b');
