@block

input_gain = DB_TO_K(slider1);
output_gain = DB_TO_K(slider3);

left.Phoenix_setMode(slider4, slider5);
right.Phoenix_setMode(slider4, slider5);

left.Phoenix_setProcessing(slider2 / 100.0);
right.Phoenix_setProcessing(slider2 / 100.0);

left.use_auto_gain = slider6;
right.use_auto_gain = slider6;

is_bypass = (slider7 != 0);

@sample

(!is_bypass) ? (
  spl0 = left.Phoenix_processSample(spl0 * input_gain) * output_gain;
  spl1 = right.Phoenix_processSample(spl1 * input_gain) * output_gain;
);

@gfx 830 260
// UI helpers and rendering code belong to the graphics context.
function knob_column(index) (1 + 14*index;);
function brightness_name(index) (
  index == 0 ? "Opal" : index == 1 ? "Gold" : "Sapphire";
);
function type_name(index) (
  index == 0 ? "Luminescent" : index == 1 ? "Iridescent" :
  index == 2 ? "Radiant" : index == 3 ? "Luster" : "Dark Essence";
);
function parameter_name(index) (
  index == 0 ? "INPUT TRIM" : index == 1 ? "PROCESS" :
  index == 2 ? "OUTPUT TRIM" : index == 3 ? "BRIGHTNESS" : "TYPE";
);

// Calculate character-cell background shadows; cache on the first graphics frame.
function shadow_gray(x, y)
local(i cx cy dx dy radial cast_radius downward cast contact transmission)
(
  transmission = 1;
  i = 0;
  loop(5,
    cx = knob_column(i) + ui.left + 4.5;
    cy = ui.knob_top + 5;
    dx = (x-cx)/4.4;
    dy = (y-cy)/4.85;
    radial = sqrt(dx*dx + dy*dy);
    dx = (x-cx-0.15)/4.4;
    dy = (y-cy-0.6)/4.85;
    cast_radius = sqrt(dx*dx + dy*dy);
    downward = min(1, max(0.15, (y-cy+2)/6));
    cast = 0.13*exp(-0.5*(max(0,cast_radius-1)/0.30)^2)*downward;
    contact = 0.020*exp(-0.5*((radial-1)/0.12)^2);
    transmission *= 1-cast-contact;
    i += 1;
  );
  140*transmission;
);

function knob_sample(base, x, y, channels, channel)
local(x0 y0 x1 y1 tx ty a b c d)
(
  x = max(0,min(knob.size-1,x-0.5));
  y = max(0,min(knob.size-1,y-0.5));
  x0 = floor(x); y0 = floor(y);
  x1 = min(knob.size-1,x0+1); y1 = min(knob.size-1,y0+1);
  tx = x-x0; ty = y-y0;
  a = base[(y0*knob.size+x0)*channels+channel];
  b = base[(y0*knob.size+x1)*channels+channel];
  c = base[(y1*knob.size+x0)*channels+channel];
  d = base[(y1*knob.size+x1)*channels+channel];
  (a*(1-tx)+b*tx)*(1-ty)+(c*(1-tx)+d*tx)*ty;
);
function circle_primitive(x, center, radius)
local(t)
(
  t = max(-radius,min(radius,x-center));
  abs(abs(t)-radius)<0.000000000001 ? sign(t)*$pi*radius*radius/4 :
    0.5*(t*sqrt(max(0,radius*radius-t*t))+radius*radius*asin(t/radius));
);
function circle_coverage(x0,y0,x1,y1,cx,cy,r)
local(left right count edge dy dx i j tmp a b t h upper_constant lower_constant upper lower area)
(
  left = max(x0,cx-r); right = min(x1,cx+r);
  left >= right || y1 <= cy-r || y0 >= cy+r ? 0 : (
    knob.cuts[0] = left; knob.cuts[1] = right; count = 2;
    edge = 0;
    loop(2,
      dy = (edge == 0 ? y0 : y1)-cy;
      abs(dy)<r ? (
        dx = sqrt(r*r-dy*dy);
        cx-dx>left && cx-dx<right ? (knob.cuts[count]=cx-dx; count+=1;);
        cx+dx>left && cx+dx<right ? (knob.cuts[count]=cx+dx; count+=1;);
      );
      edge += 1;
    );
    i = 0;
    loop(count,
      j = i+1;
      loop(count-i-1,
        knob.cuts[j]<knob.cuts[i] ? (
          tmp=knob.cuts[j]; knob.cuts[j]=knob.cuts[i]; knob.cuts[i]=tmp;
        );
        j += 1;
      );
      i += 1;
    );
    area=0; i=1;
    loop(count-1,
      a=knob.cuts[i-1]; b=knob.cuts[i]; t=(a+b)*0.5-cx;
      h=sqrt(max(0,r*r-t*t));
      upper_constant=y1<=cy+h; lower_constant=y0>=cy-h;
      upper=upper_constant ? y1 : cy+h;
      lower=lower_constant ? y0 : cy-h;
      upper>lower ? (
        area+=((upper_constant ? y1 : cy)-(lower_constant ? y0 : cy))*(b-a)
          +((upper_constant ? 0 : 1)-(lower_constant ? 0 : -1))
          *(circle_primitive(b,cx,r)-circle_primitive(a,cx,r));
      );
      i+=1;
    );
    min(1,max(0,area/((x1-x0)*(y1-y0))));
  );
);
function linear_to_byte(value) (
  value=max(0,min(1,value));
  floor(255*(value<=0.0031308 ? value*12.92 : 1.055*value^(1/2.4)-0.055)+0.5);
);

// Knob reconstruction: shade canonical normal/albedo fields and angular
// reflections, inverse-rotate the color map, then average 4x4 samples per cell.
// This runs only in @gfx, and only when a knob's parameter position changes.
function render_knob(position, destination)
local(delta co si lx ly lz i k c offset diffuse color width inset angle mx my
      row col sx sy px py alpha canonical_x canonical_y r g b opacity white cell)
(
  position=max(0,min(100,position));
  delta=knob.sweep*(position/100-0.5); co=cos(delta); si=sin(delta);
  lx=co*knob.light_x+si*knob.light_y;
  ly=-si*knob.light_x+co*knob.light_y; lz=knob.light_z;
  knob.angular[0]=1; k=1;
  loop(knob.order,
    knob.angular[k*2-1]=cos(k*delta); knob.angular[k*2]=sin(k*delta); k+=1;
  );
  i=0;
  loop(knob.size*knob.size,
    offset=i*3;
    diffuse=knob.ambient+knob.diffuse*max(0,
      knob.normals[offset]*lx+knob.normals[offset+1]*ly+knob.normals[offset+2]*lz);
    c=0;
    loop(3,
      color=knob.albedo[offset+c]*diffuse; k=0;
      loop(knob.terms,
        color+=knob.reflection[(i*knob.terms+k)*3+c]*knob.angular[k]; k+=1;
      );
      knob.colors[offset+c]=max(0,min(1,color)); c+=1;
    );
    i+=1;
  );
  width=60/knob.stretch; inset=(60-width)*0.5;
  angle=knob.start_angle+knob.sweep*position/100;
  mx=knob.marker_x+knob.marker_radius*cos(angle);
  my=knob.marker_y+knob.marker_radius*sin(angle);
  cell=0;
  loop(720,
    row=floor(cell/36); col=cell%36;
    r=0;g=0;b=0;opacity=0;sy=0;
    loop(4,
      sx=0;
      loop(4,
        px=inset+(col+(sx+0.5)/4)*width/36;
        py=(row+(sy+0.5)/4)*3;
        alpha=knob_sample(knob.alpha,px,py,1,0);
        canonical_x=knob.center_x+co*(px-knob.center_x)+si*(py-knob.center_y);
        canonical_y=knob.center_y-si*(px-knob.center_x)+co*(py-knob.center_y);
        r+=knob_sample(knob.colors,canonical_x,canonical_y,3,0)*alpha;
        g+=knob_sample(knob.colors,canonical_x,canonical_y,3,1)*alpha;
        b+=knob_sample(knob.colors,canonical_x,canonical_y,3,2)*alpha;
        opacity+=alpha; sx+=1;
      );
      sy+=1;
    );
    r/=16;g/=16;b/=16;opacity/=16;
    white=circle_coverage(inset+col*width/36,row*3,inset+(col+1)*width/36,(row+1)*3,mx,my,knob.dot_radius);
    destination[cell*4]=r*(1-white)+opacity*white;
    destination[cell*4+1]=g*(1-white)+opacity*white;
    destination[cell*4+2]=b*(1-white)+opacity*white;
    destination[cell*4+3]=opacity;
    cell+=1;
  );
);

// ---------------------------------------------------------------------------
// Drawing backend: all direct gfx calls live in this abstraction layer.
// Foreground/background colors use 0..255 channels and 0..1 opacity.
// ---------------------------------------------------------------------------
function setup_grid(columns, rows, width, height, x, y)
instance(cols lines cell_w cell_h origin_x origin_y)
(
  cols = columns; lines = rows;
  cell_w = width; cell_h = height; origin_x = x; origin_y = y;
);
function set_fg(r, g, b, opacity)
instance(fr fg fb fa)
(
  fr = r/255; fg = g/255; fb = b/255; fa = opacity;
);
function set_bg(r, g, b, opacity)
instance(br bg bb ba)
(
  br = r/255; bg = g/255; bb = b/255; ba = opacity;
);
function put_char(column, row, code)
instance(cols lines cell_w cell_h origin_x origin_y fr fg fb fa br bg bb ba)
local(x y right bottom width height)
(
  column >= 0 && column < cols && row >= 0 && row < lines ? (
    x = floor(origin_x + column*cell_w);
    y = floor(origin_y + row*cell_h);
    right = floor(origin_x + (column+1)*cell_w);
    bottom = floor(origin_y + (row+1)*cell_h);
    ba > 0 ? (
      gfx_set(br,bg,bb,ba);
      gfx_rect(x,y,right-x,bottom-y);
    );
    code != 32 && code > 0 && fa > 0 ? (
      gfx_measurechar(code,width,height);
      gfx_set(fr,fg,fb,fa);
      gfx_x=origin_x+column*cell_w+(cell_w-width)*0.5;
      gfx_y=origin_y+row*cell_h+(cell_h-height)*0.5;
      gfx_drawchar(code);
    );
  );
);
function put_text(column, row, text)
local(i count)
(
  i = 0; count = strlen(text);
  loop(count,
    this.put_char(column+i,row,str_getchar(text,i,'cu'));
    i += 1;
  );
);

// 4x4 colored subpixels per character, used by the reconstructed knobs.
// Coordinates refer to the complete terminal: [0,cols*4) x [0,lines*4).
function put_subpixel(x, y, r, g, b, opacity)
instance(cols lines cell_w cell_h origin_x origin_y)
local(left top right bottom)
(
  x >= 0 && x < cols*4 && y >= 0 && y < lines*4 ? (
    left = floor(origin_x + x*cell_w*0.25);
    top = floor(origin_y + y*cell_h*0.25);
    right = floor(origin_x + (x+1)*cell_w*0.25);
    bottom = floor(origin_y + (y+1)*cell_h*0.25);
    gfx_set(r/255,g/255,b/255,opacity);
    gfx_rect(left,top,right-left,bottom-top);
  );
);

// Fit measured glyph width and height to the cell across platform substitutions.
// Re-evaluate only after a cell-size or display-scale change.
function fit_terminal_font(width,height)
instance(last_width last_height last_retina font_size measured_width measured_height)
local(candidate w h score best_score)
(
  width!=last_width || height!=last_height || gfx_ext_retina!=last_retina || font_size==0 ? (
    best_score=1000000;candidate=8;font_size=8;
    loop(93,
      gfx_setfont(1,"Courier New",candidate,'b');
      gfx_measurestr("M",w,h);
      score=abs(h-height)+abs(w-width);
      score<best_score ? (best_score=score;font_size=candidate;);
      candidate+=1;
    );
    gfx_setfont(1,"Courier New",font_size,'b');
    gfx_measurestr("M",measured_width,measured_height);
    last_width=width;last_height=height;last_retina=gfx_ext_retina;
  ) : gfx_setfont(1);
);

// Configure the terminal grid, vector font and window background.
function begin_terminal_frame()
local(cell_w cell_h origin_x origin_y)
(
  cell_w = min(gfx_w/ui.columns, gfx_h/(ui.rows*2));
  cell_h = cell_w*2;
  origin_x = (gfx_w-ui.columns*cell_w)*0.5;
  origin_y = (gfx_h-ui.rows*cell_h)*0.5;
  crt.setup_grid(ui.columns,ui.rows,cell_w,cell_h,origin_x,origin_y);
  crt.fit_terminal_font(cell_w,cell_h);
  gfx_set(37/255,39/255,41/255,1);
  gfx_rect(0,0,gfx_w,gfx_h);
);

// UI helpers use logical character coordinates; ui_text adds panel padding.
function ui_text(column, row, text, r, g, b, opacity)
(
  crt.set_fg(r,g,b,opacity);
  crt.set_bg(0,0,0,0);
  crt.put_text(column+ui.left,row+ui.top,text);
);
function ui_mode(column, row, text, selected)
(
  selected ? ui_text(column,row,text,41,63,89,ui.opacity) :
             ui_text(column,row,text,40,40,40,ui.opacity);
);
function ui_dot(column, row)
(
  ui_text(column,row,".",40,40,40,0.35*ui.opacity);
);
function ui_value(column, row, text)
local(i start count code base bg fg)
(
  count = min(12,strlen(text));
  start = floor((12-count)/2);
  i = 0;
  loop(12,
    // Composite both ink and box against the actual shadow color. This avoids
    // applying the 50% bypass fade twice where white ink covers a black box.
    base = ui.shadow[(row+ui.top)*ui.columns+column+ui.left+i];
    bg = 17*ui.opacity + base*(1-ui.opacity);
    fg = 255*ui.opacity + base*(1-ui.opacity);
    crt.set_bg(bg,bg,bg,1);
    crt.set_fg(fg,fg,fg,1);
    code = i >= start && i < start+count ? str_getchar(text,i-start,'cu') : 32;
    crt.put_char(column+ui.left+i,row+ui.top,code);
    i += 1;
  );
);

// Draw a cached 36x20 knob through the terminal's 4x subpixel backend.
function ui_knob(index, position)
local(destination cell alpha r g b column x y)
(
  position=max(0,min(100,position));
  destination=knob.frames+index*2880;
  !knob.valid[index] || abs(knob.positions[index]-position)>0.0000000001 ? (
    render_knob(position,destination);
    knob.positions[index]=position; knob.valid[index]=1;
  );
  column=knob_column(index)+ui.left; cell=0;
  loop(720,
    alpha=destination[cell*4+3];
    alpha>=0.5 ? (
      r=linear_to_byte(destination[cell*4]/alpha);
      g=linear_to_byte(destination[cell*4+1]/alpha);
      b=linear_to_byte(destination[cell*4+2]/alpha);
      x=column*4+cell%36; y=ui.knob_top*2+floor(cell/36);
      crt.put_subpixel(x,y,r,g,b,ui.opacity);
    );
    cell+=1;
  );
);

// Mouse state and geometry use terminal cells; drag distance uses screen pixels.
function parameter_min(index) (index==0 ? -10 : index==2 ? -6 : 0;);
function parameter_max(index) (index==0 ? 10 : index==1 ? 100 : index==2 ? 6 : index==3 ? 2 : 4;);
function parameter_default(index) (index==3 || index==4 ? 1 : 0;);
function set_parameter(index,value)
local(mask quantized)
(
  quantized = index>=3 ? floor(value+0.5) : floor(value*100+0.5)/100;
  quantized = min(parameter_max(index),max(parameter_min(index),quantized));
  mask=2^index;
  slider(index+1)!=quantized ? (
    slider(index+1)=quantized;
    slider_automate(mask);
  );
);
function inside(x,y,left,top,width,height)
(x>=left && x<left+width && y>=top && y<top+height;);
function hit_label(x,y,column,row,text)
(inside(x,y,column+ui.left,row+ui.top,strlen(text),1););
function show_parameter_menu(index,px,py)
local(i count result current name)
(
  strcpy(#selector_menu,"");
  count=index==3 ? 3 : 5;
  current=floor(slider(index+1)+0.5);
  i=0;loop(count,
    i>0 ? strcat(#selector_menu,"|");
    i==current ? strcat(#selector_menu,"!");
    name=index==3 ? brightness_name(i) : type_name(i);
    strcat(#selector_menu,name);i+=1;
  );
  gfx_x=px;gfx_y=py;
  result=gfx_showmenu(#selector_menu);
  result>0 && result<=count ? set_parameter(index,result-1);
);
function process_mouse(px,py,cap,wheel,now)
local(x y hover option option_index target i column label left down pressed released fine span delta dbl click_id menu_index)
(
  x=(px-crt.origin_x)/crt.cell_w;
  y=(py-crt.origin_y)/crt.cell_h;
  hover=-1; menu_index=-1; option=-1; option_index=-1; target=0;
  i=0;
  loop(5,
    column=knob_column(i);
    label=parameter_name(i);
    left=column+4-floor(strlen(label)/2)+(i>=3);
    inside(x,y,column+ui.left,ui.knob_top/2,9,5) ||
    inside(x,y,column-1+ui.left,9+ui.top,12,1) || hit_label(x,y,left,8,label) ? hover=i;
    i>=3 && (inside(x,y,column-1+ui.left,9+ui.top,12,1) || hit_label(x,y,left,8,label)) ? menu_index=i;
    i+=1;
  );
  hit_label(x,y,40,1,"Opal") ? (option=3;option_index=0;);
  hit_label(x,y,45,0,"Gold") ? (option=3;option_index=1;);
  hit_label(x,y,50,1,"Sapphire") ? (option=3;option_index=2;);
  i=0;loop(5,
    hit_label(x,y,66+(i==1 || i==3 ? 1 : i==2 ? 2 : 0),2+i,type_name(i)) ? (option=4;option_index=i;);
    i+=1;
  );
  hit_label(x,y,1,7,"-10") ? (option=0;option_index=-10;);
  hit_label(x,y,8,7,"10") ? (option=0;option_index=10;);
  hit_label(x,y,5,7,"DB") ? (option=0;option_index=0;);
  hit_label(x,y,15,7,"0") ? (option=1;option_index=0;);
  hit_label(x,y,21,7,"100") ? (option=1;option_index=100;);
  hit_label(x,y,29,7,"-6") ? (option=2;option_index=-6;);
  hit_label(x,y,37,7,"6") ? (option=2;option_index=6;);
  hit_label(x,y,33,7,"DB") ? (option=2;option_index=0;);
  inside(x,y,80,0,3,1) ? target=1;
  inside(x,y,1,12,1,1) ? target=2;
  ui.auto_expanded && hit_label(x,y,-1,11,"[x] Auto Gain") ? target=3;
  option>=0 ? hover=option;
  down=cap&1;pressed=down && !mouse.previous_down;released=!down && mouse.previous_down;
  fine=cap&8 ? 0.1 : 1;
  pressed ? (
    target ? (
      target==1 ? (slider7=1-slider7;slider_automate(64);) :
      target==2 ? ui.auto_expanded=!ui.auto_expanded :
      (slider6=1-slider6;slider_automate(32););
      mouse.last_click=-1;
    ) : hover>=0 ? (
      click_id=hover;
      dbl=mouse.last_click==click_id && now-mouse.last_time<0.35 &&
          abs(px-mouse.last_x)<4 && abs(py-mouse.last_y)<4 && !mouse.last_moved;
      cap&4 || dbl ? (
        set_parameter(hover,parameter_default(hover));
        mouse.last_click=-1;
      ) : menu_index>=0 ? (
        show_parameter_menu(menu_index,px,py);
        mouse.last_click=-1;mouse.drag=-1;
      ) : (
        mouse.last_click=click_id;mouse.last_time=now;
        mouse.last_x=px;mouse.last_y=py;mouse.last_moved=0;
        option>=0 ? set_parameter(option,option_index) : (
          mouse.drag=hover;mouse.raw=slider(hover+1);mouse.drag_y=py;
        );
      );
    ) : mouse.last_click=-1;
  );
  down && mouse.drag>=0 ? (
    delta=mouse.drag_y-py;
    span=parameter_max(mouse.drag)-parameter_min(mouse.drag);
    mouse.raw=min(parameter_max(mouse.drag),max(parameter_min(mouse.drag),mouse.raw+delta*span/220*fine));
    delta!=0 ? set_parameter(mouse.drag,mouse.raw);
    abs(py-mouse.last_y)>=4 ? mouse.last_moved=1;
    mouse.drag_y=py;
  );
  released && mouse.drag>=0 ? (
    mouse.drag=-1;
  );
  wheel!=0 && hover>=0 && mouse.drag<0 && !target ? (
    // One notch = 5% of a continuous range, or one discrete mode.
    span=parameter_max(hover)-parameter_min(hover);
    delta=wheel/120*(hover>=3 ? 1 : span/20*fine);
    mouse.wheel_target!=hover ? mouse.wheel_raw=slider(hover+1);
    abs(slider(hover+1)-mouse.wheel_value)>0.000001 ? mouse.wheel_raw=slider(hover+1);
    mouse.wheel_target=hover;
    mouse.wheel_raw=min(parameter_max(hover),max(parameter_min(hover),mouse.wheel_raw+delta));
    set_parameter(hover,mouse.wheel_raw);mouse.wheel_value=slider(hover+1);
    mouse.last_click=-1;
  );
  mouse.previous_down=down;
  mouse.cursor=mouse.drag>=0 ? 32512 : target || option>=0 || menu_index>=0 ? 32649 : 32512;
);

// ---------------------------------------------------------------------------
// Scene. Parameters remain automatable; native slider widgets are hidden.
// Mouse edits notify REAPER automation; native sliders stay hidden.
// ---------------------------------------------------------------------------
// Build the character-space shadow cache once, on the first graphics frame.
!ui.graphics_initialized ? (
row = 0;
loop(ui.rows,
  col = 0;
  loop(ui.columns,
    gray = 0;
    sy = 0;
    loop(4,
      sx = 0;
      loop(4,
        gray += shadow_gray(col+(sx+0.5)/4, (row+(sy+0.5)/4)*2);
        sx += 1;
      );
      sy += 1;
    );
    ui.shadow[row*ui.columns+col] = floor(gray/16+0.5);
    col += 1;
  );
  row += 1;
);

  ui.graphics_initialized=1;
);
begin_terminal_frame();
gfx_getchar(); // Refresh modifier state even while hovering.
process_mouse(mouse_x,mouse_y,mouse_cap,mouse_wheel,time_precise());
mouse_wheel=0;
gfx_setcursor(mouse.cursor);
ui.opacity = slider7 >= 0.5 ? 0.5 : 1;
brightness = min(2,max(0,floor(slider4+0.5)));
tape_type = min(4,max(0,floor(slider5+0.5)));

row = 0;
loop(ui.rows,
  col = 0;
  loop(ui.columns,
    gray = ui.shadow[row*ui.columns+col];
    crt.set_bg(gray,gray,gray,1);
    crt.put_char(col,row,32);
    col += 1;
  );
  row += 1;
);

ui_text(0,0,"P H O E N I X _ T A P E",56,56,56,1);
ui_mode(40,1,"Opal",brightness==0);
ui_mode(45,0,"Gold",brightness==1);
ui_mode(50,1,"Sapphire",brightness==2);
ui_mode(66,2,"Luminescent",tape_type==0);
ui_mode(67,3,"Iridescent",tape_type==1);
ui_mode(68,4,"Radiant",tape_type==2);
ui_mode(67,5,"Luster",tape_type==3);
ui_mode(66,6,"Dark Essence",tape_type==4);
ui_text(1,7,"-10 DB 10",40,40,40,ui.opacity);
ui_text(15,7,"0     100",40,40,40,ui.opacity);
ui_text(29,7,"-6  DB  6",40,40,40,ui.opacity);

i = 0;
loop(5,
  column = knob_column(i);
  position = i == 0 ? (slider1+10)*5 : i == 1 ? slider2 :
             i == 2 ? (slider3+6)*100/12 : i == 3 ?
             knob.brightness_positions[brightness] : knob.type_positions[tape_type];
  ui_knob(i,position);
  i < 3 ? (
    ui_dot(column+4,1);
    ui_dot(column-1,3); ui_dot(column+9,3);
    ui_dot(column,6); ui_dot(column+8,6);
  );
  i == 3 ? (
    ui_dot(column-1,2); ui_dot(column+4,1); ui_dot(column+9,2);
  );
  label = parameter_name(i);
  ui_text(column+4-floor(strlen(label)/2)+(i>=3),8,label,40,40,40,ui.opacity);
  i == 0 ? sprintf(#value,"%.2f dB",abs(slider1)<0.005 ? 0 : slider1) :
  i == 1 ? sprintf(#value,"%.2f",slider2) :
  i == 2 ? sprintf(#value,"%.2f dB",abs(slider3)<0.005 ? 0 : slider3) :
  i == 3 ? strcpy(#value,brightness_name(brightness)) : strcpy(#value,type_name(tape_type));
  ui_value(column-1,9,#value);
  i += 1;
);

// Corner controls share the mouse hit-testing layer.
crt.set_bg(0,0,0,0);
slider7 < 0.5 ? crt.set_fg(41,63,89,1) : crt.set_fg(40,40,40,1);
crt.put_text(80,0,slider7<0.5 ? "[x]" : "[ ]");
crt.set_fg(41,63,89,1);
crt.put_char(1,12,9658); // U+25BA: filled right-pointing pointer.
ui.auto_expanded ? ui_text(-1,11,slider6>=0.5 ? "[x] Auto Gain" : "[ ] Auto Gain",41,63,89,ui.opacity);
crt.set_fg(36,121,125,1); crt.set_bg(247,250,251,1); crt.put_text(75,12,"J");
crt.set_fg(247,250,251,1); crt.set_bg(36,121,125,1); crt.put_text(76,12,"Clones");
