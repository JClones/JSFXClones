 row<22?0xb8af9f :
 row<23?0xb9b09f : 0xb8ae9c;
);
function ui_background() local(row,col,color) (
 row=0;loop(24,color=ui_background_color(row);col=0;
 loop(84,ui_rect(col,row,1,1,color,1);col+=1;);row+=1;);
);
function ui_prepare_background() local(w,h) (
 gfx_getimgdim(1,w,h);
 w!=gfx_w||h!=gfx_h||ui.background_cw!=ui.cw ? (
 gfx_setimgdim(1,gfx_w,gfx_h);gfx_dest=1;
 ui_color(0xb3ab96,1);gfx_rect(0,0,gfx_w,gfx_h);ui_background();
