function ui_hit(x,y,left,top,width,height) (x>=left&&x<left+width&&y>=top&&y<top+height;);
function ui_mouse() local(x,y,down,right,pressed,target,cy,change) (
 x=(mouse_x-ui.ox)/ui.cw;y=(mouse_y-ui.oy)/ui.ch-1;
 down=mouse_cap&1;right=mouse_cap&2;pressed=down&&!ui.was_down;target=0;
 cy=4.5+(-max(-28,min(0,slider1)))/2;
 ui_hit(x,y,7,cy-1,9,2)?target=1;
 cy=4.5+(-max(-28,min(0,slider2)))/2;
 ui_hit(x,y,28,cy-1,9,2)?target=2;
 ui_hit(x,y,42,6,4.5,12)?target=4;
 ui_hit(x,y,44,19,6,3)?target=3;
 ui_hit(x,y,69,6,10,3)?target=5;
 ui_hit(x,y,69,12,10,3)?target=6;
 ui_hit(x,y,69,18,10,3)?target=7;
 ui_hit(x,y+1,81,0,3,1)?target=8;
 ui_hit(x,y,20,10,5,3)?target=9;
 right&&!ui.was_right&&!down&&target>=5&&target<=7 ? ui_popup(target);
 pressed ? (
 ui.drag=0;
 target==1||target==2||target==4 ? (
 ui.drag=target;ui.drag_y=y;ui.drag_value=slider(target);
 ui.drag_threshold=slider1;ui.drag_ceiling=slider2;
 (slider9>=0.5)&&target<=2 ? ui.drag_value=max(-28,min(0,ui.drag_value));
 ) :
 target==9 ? ui_set(9,1-slider9) :
 target==3||target==8 ? ui_set(target,1-slider(target)) :
 target>=5&&target<=7 ? ui_set(target,(slider(target)+1)%(target==5?5:target==6?3:4));
 );
 down&&ui.drag>0 ? (
 change=(ui.drag_y-y)*(ui.drag==4?0.5:2);
 // Keep host automation below -28 intact until a real GUI movement occurs.
 abs(y-ui.drag_y)>0.00001 ? (
 (slider9>=0.5)&&ui.drag<=2 ? ui_set_linked(ui.drag,ui.drag_value+change,ui.drag_threshold,ui.drag_ceiling) :
 ui_set(ui.drag,ui.drag_value+change);
 );
 );
 !down?ui.drag=0;
 mouse_wheel!=0&&target>0 ? (
 target==1||target==2||target==4 ? ui_set(target,slider(target)+(mouse_wheel>0?0.1:-0.1));mouse_wheel=0;
 );
 gfx_setcursor(target==1||target==2||target==4?32645:target>0?32649:32512);
 ui.was_down=down;ui.was_right=right;
);
function ui_draw() local(i,y) (
 ui_text(33,1,"J C l o n e s  L 2",0x29261b,1);
 ui_text(7,3,"THRESHOLD",0x29261b,1);ui_text(27,3,"OUT CEILING",0x29261b,1);
 ui_text(43,3,"RELEASE",0x29261b,1);ui_text(57,3,"ATTEN",0x29261b,1);
 ui.oy+=ui.ch;
 ui_meter(6,meters.input_left_dB,28,0);ui_meter(16,meters.input_right_dB,28,0);
 ui_meter(27,meters.output_left_dB,28,0);ui_meter(37,meters.output_right_dB,28,0);
 ui_meter(60,meters.gr_dB,21,1);
 i=0;loop(7,y=5+2*i;
 ui_text(9,y,"-",0x655e4b,1);ui_text(14,y,"-",0x655e4b,1);
 ui_text(30,y,"-",0x655e4b,1);ui_text(35,y,"-",0x655e4b,1);i+=1;);
 i=0;loop(8,sprintf(#ui.scale,"%2d",i*3);ui_text(55,4+i*2,#ui.scale,0x29261b,1);ui_text(58,4+i*2,"-",0x655e4b,1);i+=1;);
 ui_cap(7,slider1);ui_cap(28,slider2);ui_release();
 ui_frame(44,19,6,"ARC",slider3>=0.5,0,0);
 ui_frame(20,10,5,"< >",slider9>=0.5,0,1);
 ui_button(5,6,"QUANTIZE");ui_button(6,12,"DITHER");ui_button(7,18,"SHAPING");
 ui_peak(6,meters.input_left_peak_hold_dB);ui_peak(12,meters.input_right_peak_hold_dB);
 ui_peak(27,meters.output_left_peak_hold_dB);ui_peak(33,meters.output_right_peak_hold_dB);
 ui_peak(57,meters.gr_peak_hold_dB);
 ui.oy-=ui.ch;
);
ui.cw=min(gfx_w/84,gfx_h/48);ui.ch=ui.cw*2;
ui.ox=(gfx_w-84*ui.cw)/2;ui.oy=(gfx_h-24*ui.ch)/2;
ui_fit_font();gfx_getchar();ui_mouse();
