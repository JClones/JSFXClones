function ui_meter(x,value,range,down) local(i,t,fill,lit,color) (
 ui_fill(x-0.25,3.75,1.5,15.5,0x746d57,1);
 ui_fill(x,4,1,15,0x302c1c,1);
 fill=max(0,min(1,down?-value/range:(range+value)/range));
 // Round all meters to the nearest subpixel; light a row at half coverage.
