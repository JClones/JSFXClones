 ui_fill(x,4+i/4,1,0.25,color,1);
 );i+=1;);
);
function ui_peak(x,value) (
 ui_fill(x,20,5,1,0x37321f,1);
 value<=meters.MIN_LEVEL_DB ? #ui.peak="-inf" : value<=-100 ? sprintf(#ui.peak,"%.0f",value) : sprintf(#ui.peak,"%.1f",value);
 ui_text(x+(5-strlen(#ui.peak))/2,20,#ui.peak,0xff9600,1);
