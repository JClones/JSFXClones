// Bitmap shape adapters retain their colored-cell design, with real-pixel motion.
function ui_cap_color(x,y) local(side,result) (
 result=-1;
 x<3||x>28 ? (
 side=x<3?x:31-x;
 y>=2&&y<=5&&side>=((y==2||y==5)?2:0) ?
 result=side==0?0x393526:y<=3?0xeee5cc:0x91866a;
 ) : (
 result=y==0||y==7?0x322d20:x==3?0x4a4431:x==28?0x302b20:
 y==1?0xe5ddc5:x==27?0xd7cdb2:x==4?0x8e8261:y==6?0x827452:
 x==5||x==26?0x62583d:y==2?0x373020:y==5?0x48402d:0x17130c;
 );result;
);
function ui_cap(x,value) local(y,i,j,color) (
 y=4.5+(-max(-28,min(0,value)))/2-1;
 j=0;loop(8,i=0;loop(32,color=ui_cap_color(i,j);
 color>=0 ? ui_fill(x+0.5+i/4,y+j/4,0.25,0.25,color,1);i+=1;);j+=1;);
 sprintf(#ui.value,"%.1f",value);ui_text(x+(9-strlen(#ui.value))/2,y+0.5,#ui.value,0xe7e1d4,1);
);
function ui_release_color(x,y) local(v) (
 x==0||y==0 ? 0xd4c9af : x==13||y==11 ? 0x4b4434 :
 y==5 ? 0x393125 : y==6 ? 0xe0d4b8 : (
 v=floor(135+65*sin(y/12*$pi)+0.5);(v<<16)|((v-9)<<8)|(v-28);
 );
);
function ui_release() local(alpha,i,j,y,color,inside) (
 alpha=slider3>=0.5?0.5:1;
 ui_fill(43,4,7,1,0x37321f,alpha);ui_release_text(slider4);
 sprintf(#ui.padded,"%6s",#ui.release);ui_text(43,4,#ui.padded,0xeee7d3,alpha);
 // The rail is painted before the opaque handle; ARC blends the cap over it.
 i=0;loop(11,ui_char(44,6+i,9474,0x302b20,alpha);i+=1;);
 i=0;loop(6,
 i==0?#ui.tick="1000":i==1?#ui.tick="100":i==2?#ui.tick="10.0":
 i==3?#ui.tick="1.0":i==4?#ui.tick="0.1":#ui.tick="0.01";
 ui_text(46,6+i*2,"-",0x655e4b,alpha);ui_text(48,6+i*2,#ui.tick,0x29261b,alpha);i+=1;);
 y=floor((15-2*slider4)*4+0.5)/4;
 j=0;loop(12,i=0;loop(14,color=ui_release_color(i,j);
 ui_fill(42.75+i/4,y+j/4,0.25,0.25,color,alpha);i+=1;);j+=1;);
);
function ui_button(id,y,label) (
 ui_text(69+(10-strlen(label))/2,y-2,label,0x29261b,1);
 ui_fill(69,y,10,3,0x242219,1);
 id==5 ? (slider5<0.5?#ui.choice="16 Bits":slider5<1.5?#ui.choice="18 Bits":slider5<2.5?#ui.choice="20 Bits":slider5<3.5?#ui.choice="22 Bits":#ui.choice="24 Bits";) :
 id==6 ? (slider6<0.5?#ui.choice="NONE":slider6<1.5?#ui.choice="TYPE 1":#ui.choice="TYPE 2";) :
