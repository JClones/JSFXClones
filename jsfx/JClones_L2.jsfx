// Linking applies relative dB changes; slider9 stores the Link state.
function ui_set_linked(id,value,base_threshold,base_ceiling) local(delta,lo,hi,next_threshold,next_ceiling,mask) (
 base_threshold=max(-28,min(0,base_threshold));base_ceiling=max(-28,min(0,base_ceiling));
 delta=value-(id==1?base_threshold:base_ceiling);
 lo=max(-28-base_threshold,-28-base_ceiling);hi=min(-base_threshold,-base_ceiling);
 delta=floor(max(lo,min(hi,delta))*10+0.5)/10;
 next_threshold=floor((base_threshold+delta)*10+0.5)/10;
 next_ceiling=floor((base_ceiling+delta)*10+0.5)/10;
 mask=0;
 slider1!=next_threshold ? (slider1=next_threshold;mask|=1;);
 slider2!=next_ceiling ? (slider2=next_ceiling;mask|=2;);
 mask ? sliderchange(mask);
);
function ui_set(id,value) local(next) (
 (slider9>=0.5)&&id<=2 ? ui_set_linked(id,value,slider1,slider2) : (

 next=id<=2 ? floor(max(-28,min(0,value))*10+0.5)/10 :
 id==4 ? floor(max(0,min(5,value))*10+0.5)/10 : value;
 slider(id)!=next ? (slider(id)=next;sliderchange(2^(id-1)););
 );
);
// Native popup lists use the same zero-based values as the host parameters.
function ui_popup(id) local(i,count,choice) (
 #ui.menu="";i=0;count=id==5?5:id==6?3:4;
 loop(count,
 i>0 ? strcat(#ui.menu,"|");
 floor(slider(id)+0.5)==i ? strcat(#ui.menu,"!");
 id==5 ? sprintf(#ui.menuitem,"%d Bits",16+2*i) :
 id==6 ? (#ui.menuitem=i==0?"NONE":i==1?"TYPE 1":"TYPE 2";) :
 (#ui.menuitem=i==0?"NONE":i==1?"MODERATE":i==2?"NORMAL":"ULTRA";);
 strcat(#ui.menu,#ui.menuitem);i+=1;
 );
 gfx_x=mouse_x;gfx_y=mouse_y;
 choice=gfx_showmenu(#ui.menu);
 choice>0 ? ui_set(id,choice-1);
