function ui_text(x,y,str,color,alpha) local(i) (
 i=0;loop(strlen(str),ui_char(x+i,y,str_getchar(str,i),color,alpha);i+=1;);
);
function ui_fill(x,y,w,h,color,alpha) (ui_rect(x,y,w,h,color,alpha););
function ui_fit_font() local(candidate,w,h,error,best) (
 ui.last_cw!=ui.cw || ui.last_ch!=ui.ch || ui.last_retina!=gfx_ext_retina || !ui.font ? (
 best=1000000000;candidate=8;
 loop(93,gfx_setfont(1,"Courier New",candidate,'b');gfx_measurestr("M",w,h);
 error=abs(w-ui.cw)+abs(h-ui.ch);
 error<best ? (best=error;ui.font=candidate;);candidate+=1;);
 ui.last_cw=ui.cw;ui.last_ch=ui.ch;ui.last_retina=gfx_ext_retina;
 );gfx_setfont(1,"Courier New",ui.font,'b');
);
function ui_release_text(value) local(ms) (
 ms=10^(value-2);
 ms<0.1 ? sprintf(#ui.release,"%.2f",ms) :
 ms<100 ? sprintf(#ui.release,"%.1f",ms) : sprintf(#ui.release,"%.0f",ms);
);
function ui_frame(x,y,w,str,on,dark,lit) local(a,b,i) (
 a=(on||dark)?0x554f40:0xe5dbc1;b=(on||dark)?0xe5dbc1:0x554f40;
 ui_char(x,y,9484,a,1);ui_char(x+w-1,y,9488,a,1);
 ui_char(x,y+2,9492,b,1);ui_char(x+w-1,y+2,9496,b,1);
 i=1;loop(w-2,ui_char(x+i,y,9472,a,1);ui_char(x+i,y+2,9472,b,1);i+=1;);
 ui_char(x,y+1,9474,a,1);ui_char(x+w-1,y+1,9474,b,1);
 on&&!lit ? ui_fill(x+1,y+1,w-2,1,0x7395df,1);
